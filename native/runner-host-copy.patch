+
+#[cfg(test)]
+mod dense_output_tests {
+    use super::*;
+
+    fn buffer(shape: &[u64], strides: &[u64], offset: u64) -> RuntimeBuffer {
+        serde_json::from_value(serde_json::json!({
+            "id": 0, "role": "output",
+            "tensor": {"dtype": "u8", "shape": shape,
+                "layout": {"strides": strides, "storage_offset": offset},
+                "device": {"target": {"ordinal": 0}}},
+            "storage": {"external": {"slot": "output.0", "stability": "stable"}},
+            "extent": 64, "alignment": 1, "mutability": "mutable"
+        })).unwrap()
+    }
+
+    #[test]
+    fn dense_preserves_bytes_offset_and_bounds() {
+        let slot = ExternalSlotId::from("output.0".to_owned());
+        let b = buffer(&[2, 3], &[3, 1], 2);
+        let bytes: Vec<u8> = (0..12).collect();
+        assert_eq!(unpack_shape(&b, &[2, 3], &bytes, &slot).unwrap(), bytes[2..8]);
+        assert!(unpack_shape(&b, &[2, 3], &bytes[..7], &slot).is_err());
+        assert_eq!(unpack_shape(&buffer(&[0], &[1], 0), &[0], &[], &slot).unwrap(), Vec::<u8>::new());
+    }
+
+    #[test]
+    fn transposed_and_dynamic_shapes_still_use_strides() {
+        let slot = ExternalSlotId::from("output.0".to_owned());
+        let bytes: Vec<u8> = (0..12).collect();
+        assert_eq!(unpack_shape(&buffer(&[2, 3], &[1, 2], 0), &[2, 3], &bytes, &slot).unwrap(), [0, 2, 4, 1, 3, 5]);
+        assert_eq!(unpack_shape(&buffer(&[2, 3], &[3, 1], 0), &[2, 2], &bytes, &slot).unwrap(), [0, 1, 3, 4]);
+        assert!(unpack_shape(&buffer(&[2, 3], &[3, 1], 0), &[3, 3], &bytes, &slot).is_err());
+    }
+
+    #[test]
+    fn channels_last_pack_is_bitwise_with_offsets_and_batch() {
+        let slot = ExternalSlotId::from("output.0".to_owned());
+        for n in [1, 2] {
+            let mut b = buffer(&[n, 3, 2, 4], &[if n == 1 { 3 } else { 24 }, 1, 12, 3], 2);
+            b.tensor.dtype = DType::F32;
+            b.extent = ByteSize((n * 24 + 2) * 4);
+            let bytes: Vec<u8> = (0..n * 24 * 4).map(|x| x as u8).collect();
+            let packed = pack_compact(&b, &bytes, &slot).unwrap();
+            assert_eq!(unpack_shape(&b, &[n, 3, 2, 4], &packed, &slot).unwrap(), bytes);
+            assert_eq!(&packed[..8], &[0; 8]);
+            b.extent = ByteSize(1);
+            assert!(pack_compact(&b, &bytes, &slot).is_err());
+        }
+    }
 }
 
