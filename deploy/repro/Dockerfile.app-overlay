# Application-only overlay. Verify BASE_IMAGE's local ID before building.
ARG BASE_IMAGE
FROM ${BASE_IMAGE}
ARG SOURCE_COMMIT
LABEL org.opencontainers.image.source="https://github.com/Spring-Silicon/turret-demo" \
      org.opencontainers.image.revision="${SOURCE_COMMIT}"
USER root
# A base image may already contain an earlier application overlay's wheel.
COPY dist/*.whl /tmp/turret-release/${SOURCE_COMMIT}/
RUN python3 -m pip install --no-index --no-deps --force-reinstall /tmp/turret-release/${SOURCE_COMMIT}/*.whl
COPY app /opt/turret-demo
COPY release.json /opt/turret-demo/release.json
USER 1000:1000
