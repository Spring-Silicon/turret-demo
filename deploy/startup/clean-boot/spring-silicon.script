# Stay black on the firmware framebuffer. The root service reveals the logo
# only after the native display framebuffer is active.
Window.SetBackgroundTopColor(0, 0, 0);
Window.SetBackgroundBottomColor(0, 0, 0);
logo.image = Image("spring-silicon-plymouth.png");
logo.sprite = Sprite(logo.image);
logo.sprite.SetOpacity(0);
global.ready = 0;

fun place_logo() {
  logo.sprite.SetX(Window.GetWidth() / 2 - logo.image.GetWidth() / 2);
  logo.sprite.SetY(Window.GetHeight() / 2 - logo.image.GetHeight() / 2);
  logo.sprite.SetOpacity(global.ready);
}
fun message_callback(text) {
  if (text == "spring-native-display-ready") {
    global.ready = 1;
    place_logo();
  }
}
Plymouth.SetRefreshFunction(place_logo);
Plymouth.SetMessageFunction(message_callback);
