[Unit]
Description=Fullscreen Firefox for Arc and Thor demo
Wants=spring-turret-frontend.service
After=spring-turret-frontend.service
StartLimitIntervalSec=0

[Service]
Type=simple
# Firefox 147 can create an invisible kiosk window on Wayland (Mozilla 2014372).
# The dedicated kiosk session supplies X11; Ubuntu fallback uses XWayland.
Environment=MOZ_ENABLE_WAYLAND=0
Environment=GDK_BACKEND=x11
Environment=DISABLE_WAYLAND=1
ExecStart=%h/.local/share/spring-turret-frontend/scripts/open-kiosk.sh
Restart=always
RestartSec=5
TimeoutStopSec=15
