#!/bin/sh
# Install in NetworkManager/dispatcher.d/pre-up.d, root-owned mode 0755.
# Keep the guard installed when the cable goes down; never touch other tables.
set -eu
[ "${CONNECTION_ID:-}" = "turret-direct-ethernet" ] || exit 0
case "${1:-}" in enp8s0|enP2p1s0) ;; *) exit 0 ;; esac
/usr/sbin/nft list table inet turret_direct_link >/dev/null 2>&1 ||
    /usr/sbin/nft -f /etc/spring-turret-direct-link.nft
